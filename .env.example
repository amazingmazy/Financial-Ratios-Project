# Example .env for this project.
#
# Copy this file to `.env` in the project root and edit the values. `.env` is
# gitignored and must never be committed -- see the note on the WRDS password
# below.
#
# Everything here is optional except WRDS_USERNAME. `src/settings.py` supplies a
# sensible default for every other key, so the project runs from a fresh clone
# with only that one line set. Resolution order is:
#
#     command line  >  environment variable  >  .env  >  settings.py default
#
# so any of these can also be overridden per-run, e.g.
#
#     python src/replicate_paper_tables.py _data/master_panel.csv --n-sims 20000

# ---------------------------------------------------------------------------
# WRDS credentials
# ---------------------------------------------------------------------------
# Your WRDS login. Required for the data pulls (CRSP and Compustat); everything
# downstream of the panel runs without it.
#
# The PASSWORD deliberately does not appear here and is not read by this project
# at any point. The `wrds` client resolves it from ~/.pgpass (on Windows,
# %APPDATA%/postgresql/pgpass.conf), which lives outside the repository. Set it
# up once by running `python -c "import wrds; wrds.Connection()"` and answering
# the prompt; it will offer to store the credential for you. Never put a
# password in this file.
WRDS_USERNAME=jdoe

# ---------------------------------------------------------------------------
# Sample period
# ---------------------------------------------------------------------------
# START_DATE is 1926 because that is where CRSP begins. The replication itself
# only needs 1946 onward -- Lewellen omits the Depression era deliberately
# (Section 3), since 1930s volatility distorts both the variance and the
# persistence of dividend yield -- but the trailing-12-month dividend window
# needs pre-sample months, and the extra history leaves room for robustness
# checks.
START_DATE=1926-01-01
END_DATE=2025-12-31

# CRSP's legacy SIZ tables stopped being updated after this date, while the
# current CIZ schema runs a year further. The replication is built on SIZ and
# the extension on CIZ, so the two pulls end at different points and this is a
# separate key rather than a reuse of END_DATE.
SIZ_END_DATE=2024-12-31

# ---------------------------------------------------------------------------
# Directories
# ---------------------------------------------------------------------------
# Relative paths are resolved against the project root. DATA_DIR and OUTPUT_DIR
# hold generated artefacts and are gitignored -- CRSP and Compustat are licensed,
# so no pulled data may be committed. MANUAL_DATA_DIR is for small inputs that
# are checked in by hand.
DATA_DIR=_data
OUTPUT_DIR=_output
MANUAL_DATA_DIR=data_manual

# ---------------------------------------------------------------------------
# Estimation
# ---------------------------------------------------------------------------
# Monte Carlo draws for the Stambaugh bias correction. Raise this for anything
# reported: at 2,000 draws two different seeds gave 0.2508 and 0.2851 for the
# same slope, a spread of 0.034, which is large next to the slopes themselves.
N_SIMS=8000
